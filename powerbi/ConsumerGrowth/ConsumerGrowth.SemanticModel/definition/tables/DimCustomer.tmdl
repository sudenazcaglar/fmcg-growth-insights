	partition DimCustomer = m
		mode: import
		source =
				let
				    Customers = fnAnalyticsTable("customer_metrics", {{"customer_id", Int64.Type}, {"total_spend", type number}, {"total_transactions", Int64.Type}, {"average_basket_value", type number}, {"active_months", Int64.Type}, {"purchase_frequency", type number}, {"recency_days", Int64.Type}, {"average_items_per_basket", type number}, {"category_diversity", Int64.Type}, {"promotion_purchase_share", type number}, {"promotion_spend_share", type number}, {"top_category", type text}, {"top_category_share", type number}}),
				    JoinSegments = Table.NestedJoin(Customers, {"customer_id"}, StgCustomerSegments, {"customer_id"}, "Segment", JoinKind.LeftOuter),
				    ExpandSegments = Table.ExpandTableColumn(JoinSegments, "Segment", {"segment_id", "segment_name", "model_version"}),
				    JoinPromotion = Table.NestedJoin(ExpandSegments, {"customer_id"}, StgPromotionMetrics, {"customer_id"}, "Promotion", JoinKind.LeftOuter),
				    Result = Table.ExpandTableColumn(JoinPromotion, "Promotion", {"promo_baskets", "nonpromo_baskets", "promo_sales", "nonpromo_sales", "promo_average_basket_value", "nonpromo_average_basket_value"})
				in
				    Result

	annotation PBI_ResultType = Table

