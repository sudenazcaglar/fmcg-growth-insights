{
  "name": "Consumer Growth Light",
  "dataColors": [
    "#2563EB",
    "#7C3AED",
    "#0F9488",
    "#60A5FA",
    "#A78BFA",
    "#5EEAD4",
    "#F59E0B",
    "#94A3B8"
  ],
  "background": "#FFFFFF",
  "foreground": "#142541",
  "tableAccent": "#2563EB",
  "textClasses": {
    "callout": {
      "fontSize": 40,
      "fontFace": "Arial",
      "color": "#142541"
    },
    "title": {
      "fontSize": 24,
      "fontFace": "Arial",
      "color": "#142541"
    },
    "header": {
      "fontSize": 18,
      "fontFace": "Arial",
      "color": "#384B65"
    },
    "label": {
      "fontSize": 18,
      "fontFace": "Arial",
      "color": "#475B74"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "left": 0,
            "right": 0,
            "top": 0,
            "bottom": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontSize": 40,
            "bold": true,
            "$id": "default"
          }
        ],
        "label": [
          {
            "fontSize": 18,
            "$id": "default"
          }
        ],
        "outline": [
          {
            "show": false,
            "$id": "default"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": false,
            "columnAdjustment": "fixedWidth"
          }
        ]
      }
    }
  }
}